# RYPER AI OS — environment variables
# Copy this file to `.env` for local development. Never commit `.env` itself
# (see .gitignore). Real deployments source these from the platform's secure
# secret store (see docs/SECRETS.md) — this file only documents the names
# and shapes, it never holds a real credential.

# ---- Runtime ----
# development | staging | production
RYPER_ENV=development

# debug | info | warn | error — see core/logging
RYPER_LOG_LEVEL=info

# ---- Cloud model provider ----
# Base URL for the cloud inference provider used by @ryper/model-router's
# cloud ModelProvider implementation. Never hardcode this in source.
RYPER_CLOUD_API_BASE_URL=https://api.anthropic.com
# The API key itself is NOT read from this file in production — see
# docs/SECRETS.md. It is only read from .env in local development.
RYPER_CLOUD_API_KEY=

# ---- Sync backend ----
RYPER_SYNC_RELAY_URL=
RYPER_SYNC_ENABLED=false

# ---- Telemetry (opt-in, off by default — see infra/telemetry) ----
RYPER_TELEMETRY_ENABLED=false
RYPER_TELEMETRY_ENDPOINT=

# ---- Feature flags ----
RYPER_FEATURE_MULTI_AGENT=false
RYPER_FEATURE_KNOWLEDGE_GRAPH=false
