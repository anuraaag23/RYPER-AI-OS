{
    "name":  "@ryper/desktop-app",
    "version":  "0.1.2",
    "productName": "RYPER AI OS",
    "description": "RYPER AI OS — Autonomous Local AI Assistant for Windows",
    "author": {
        "name": "RYPER",
        "email": "contact@ryper.os"
    },
    "private":  true,
    "type":  "module",
    "main":  "./dist-electron/main.js",
    "types":  "./dist-electron/main.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist-electron/main.d.ts",
                              "import":  "./dist-electron/main.js"
                          },
                    "./package.json":  "./package.json"
                },
    "scripts":  {
                    "build":  "tsc --build && vite build && npm run build:preload",
                    "build:electron":  "tsc --build && npm run build:preload",
                    "build:renderer":  "vite build",
                    "dev:renderer":  "vite",
                    "test":  "vitest run",
                    "build:preload":  "npx esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
                    "package:dir": "npx electron-builder --dir",
                    "package:win": "npx electron-builder --win --x64"
                },
    "build": {
        "appId": "com.ryper.os",
        "productName": "RYPER AI OS",
        "electronVersion": "43.3.0",
        "copyright": "Copyright © 2026 RYPER",
        "directories": {
            "output": "dist-release",
            "buildResources": "assets"
        },
        "files": [
            "dist-electron/**/*.js",
            "dist-electron/**/*.cjs",
            "dist-renderer/**/*",
            "assets/**/*",
            "package.json",
            "!**/*.ts",
            "!**/*.map",
            "!**/*.d.ts",
            "!**/*.d.ts.map",
            "!**/test/**",
            "!**/tests/**",
            "!**/spec/**",
            "!**/node_modules/*/{src,test,tests}/**",
            "!**/node_modules/*/*/{src,test,tests}/**"
        ],
        "win": {
            "target": "nsis",
            "icon": "assets/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "RYPER AI OS",
            "uninstallDisplayName": "RYPER AI OS",
            "runAfterFinish": false
        },
        "asar": true
    },
    "dependencies":  {
                         "@ryper/logging":  "0.1.0",
                         "@ryper/event-bus":  "0.1.0",
                         "@ryper/security":  "0.1.0",
                         "@ryper/model-router":  "0.1.0",
                         "@ryper/ai-engine":  "0.1.0",
                         "@ryper/memory":  "0.1.0",
                         "@ryper/memory-system":  "0.1.0",
                         "@ryper/rag":  "0.1.0",
                         "@ryper/conversation":  "0.1.0",
                         "@ryper/web-shell":  "0.1.0",
                         "@ryper/voice-engine":  "0.1.0",
                         "@ryper/platform-capability":  "0.1.0",
                         "@ryper/windows-agent":  "0.1.0",
                         "@ryper/design-system":  "0.1.0",
                         "@ryper/components":  "0.1.0",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "marked":  "^14.1.4",
                         "highlight.js":  "^11.10.0",
                         "dompurify":  "^3.2.2"
                     },
    "devDependencies":  {
                            "electron":  "43.3.0",
                            "vite":  "^5.4.11",
                            "@vitejs/plugin-react":  "^4.3.4",
                            "@types/react":  "^18.3.12",
                            "@types/react-dom":  "^18.3.1",
                            "@testing-library/react":  "^16.0.1",
                            "jsdom":  "^25.0.1"
                        }
}
