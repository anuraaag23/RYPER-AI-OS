{
  "name": "ryper-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RYPER AI OS monorepo — cross-platform AI assistant core, plugin SDK, and design system.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "core/*",
    "ui/*",
    "plugins/*",
    "plugins/examples/*",
    "platform/web",
    "infra/telemetry"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "build:clean": "tsc --build tsconfig.json --clean",
    "typecheck": "tsc --build tsconfig.json --force",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run format:check && npm run lint && npm run build && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
